# Check out text with LF on every platform: the pipeline ownership check hashes
# generated files byte for byte, and Windows runners would otherwise convert to CRLF.
* text=auto eol=lf

# BEGIN 4D PLUGIN PIPELINE (managed)
phonon/manifest.json text eol=lf
phonon/constants.xlf text eol=lf
VERSION text eol=lf
LICENSE text eol=lf
THIRD-PARTY-NOTICES/** text eol=lf
# END 4D PLUGIN PIPELINE (managed)
